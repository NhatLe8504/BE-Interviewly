{
  "domain": "linkedin.com/jobs",
  "source_id": "linkedin",
  "source_name": "LinkedIn Jobs",
  "access_method": "guest_api_with_rate_limit",
  "verification_status": "PARTIAL",
  "last_verified_at": "2026-10-09T00:45:00+07:00",
  "tested_jobs_count": 10,
  "success_rate_pct": 90.0,
  "notes": "Verified on 10 live postings (9 succeeded, 1 rate-limited HTTP 429). Guest search & detail endpoints work without auth cookies, but strict rate-limiting / request backoff (min 1.0s interval) is mandatory.",
  "listing": {
    "url_template": "https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search?keywords={keywords}&location={location}&start={start}",
    "default_params": {
      "keywords": "Software Engineer",
      "location": "Vietnam",
      "start": 0
    },
    "card_selector": "li",
    "fields": {
      "job_id": {
        "selector": "div[data-entity-urn]",
        "attribute": "data-entity-urn",
        "regex": "jobPosting:(\\d+)"
      },
      "title": {
        "selector": "h3.base-search-card__title, .job-search-card__title",
        "attribute": "text"
      },
      "company": {
        "selector": "h4.base-search-card__subtitle, a.hidden-nested-link",
        "attribute": "text"
      },
      "location": {
        "selector": ".job-search-card__location",
        "attribute": "text"
      },
      "detail_link": {
        "selector": "a.base-card__full-link, a",
        "attribute": "href"
      }
    }
  },
  "job_id_extraction": {
    "type": "regex_entity_urn",
    "regex": "jobPosting:(\\d+)"
  },
  "detail": {
    "api_endpoint_template": "https://www.linkedin.com/jobs-guest/jobs/api/jobPosting/{job_id}",
    "direct_page_template": "https://www.linkedin.com/jobs/view/{job_id}",
    "fields": {
      "title": {
        "selectors": [
          "h1",
          "h2",
          ".top-card-layout__title"
        ],
        "attribute": "text"
      },
      "company": {
        "selectors": [
          "a.topcard__org-name-link",
          ".topcard__flavor",
          "a[data-tracking-control-name*='company']"
        ],
        "attribute": "text"
      },
      "description": {
        "selectors": [
          ".show-more-less-html__markup",
          ".description__text",
          ".description"
        ],
        "attribute": "text"
      },
      "criteria": {
        "container_selector": ".description__job-criteria-item",
        "header_selector": ".description__job-criteria-subheader",
        "text_selector": ".description__job-criteria-text"
      }
    }
  },
  "company_branding": {
    "collection_enabled": false,
    "reuse_allowed": false,
    "license_url": "",
    "reject_asset_patterns": [
      "placeholder",
      "default[-_]logo",
      "default[-_]cover"
    ],
    "allowed_page_hosts": [
      "www.linkedin.com"
    ],
    "allowed_image_hosts": [
      "media.licdn.com"
    ],
    "company_page_path_pattern": "/company/[^/]+/?",
    "company_link_selectors": [
      "a.topcard__org-name-link"
    ],
    "detail_company_name_selectors": [
      "a.topcard__org-name-link"
    ],
    "company_name_selectors": [
      "h1"
    ],
    "logo_selectors": [
      ".top-card-layout__entity-image"
    ],
    "banner_selectors": [],
    "serper_image_query_template": "site:linkedin.com/company/ {company_name}"
  },
  "normalization_rules": {
    "key_format": "linkedin:{company}:{title}:{job_id}",
    "source_badge": "via LinkedIn",
    "min_jd_length": 200,
    "request_delay_seconds": 1.2
  }
}