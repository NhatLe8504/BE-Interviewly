  "components": {
    "schemas": {
      "CheckoutIn": {
        "properties": {
          "plan_id": {
            "type": "integer",
            "title": "Plan Id"
          },
          "payment_gateway": {
            "type": "string",
            "title": "Payment Gateway",
            "default": "vnpay"
          },
          "return_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Return Url"
          }
        },
        "type": "object",
        "required": [
          "plan_id"
        ],
        "title": "CheckoutIn"
      },
      "CheckoutUrlOut": {
        "properties": {
          "transaction_ref": {
            "type": "string",
            "title": "Transaction Ref"
          },
          "payment_url": {
            "type": "string",
            "title": "Payment Url"
          },
          "amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "VND"
          }
        },
        "type": "object",
        "required": [
          "transaction_ref",
          "payment_url",
          "amount"
        ],
        "title": "CheckoutUrlOut"
      },
      "GoogleAuthIn": {
        "properties": {
          "credential": {
            "type": "string",
            "minLength": 10,
            "title": "Credential"
          }
        },
        "type": "object",
        "required": [
          "credential"
        ],
        "title": "GoogleAuthIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 255,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn"
      },
      "MessageOut": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "MessageOut"
      },
      "PaymentTransactionOut": {
        "properties": {
          "transaction_id": {
            "type": "integer",
            "title": "Transaction Id"
          },
          "user_subscription_id": {
            "type": "integer",
            "title": "User Subscription Id"
          },
          "payment_gateway": {
            "type": "string",
            "title": "Payment Gateway"
          },
          "gateway_transaction_id": {
            "type": "string",
            "title": "Gateway Transaction Id"
          },
          "amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "paid_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paid At"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          }
        },
