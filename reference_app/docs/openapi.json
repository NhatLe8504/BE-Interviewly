  "components": {
    "schemas": {
      "CandidateDashboardOut": {
        "properties": {
          "candidate_id": {
            "type": "integer",
            "title": "Candidate Id"
          },
          "kpi": {
            "$ref": "#/components/schemas/CandidateKpiStatsOut"
          },
          "skill_radar": {
            "$ref": "#/components/schemas/SkillRadarOut"
          },
          "recent_sessions": {
            "items": {
              "$ref": "#/components/schemas/RecentSessionOut"
            },
            "type": "array",
            "title": "Recent Sessions"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/WeakPointRecommendationOut"
            },
            "type": "array",
            "title": "Recommendations"
          }
        },
        "type": "object",
        "required": [
          "candidate_id",
          "kpi",
          "skill_radar",
          "recent_sessions",
          "recommendations"
        ],
        "title": "CandidateDashboardOut"
      },
      "CandidateKpiStatsOut": {
        "properties": {
          "total_interviews": {
            "type": "integer",
            "title": "Total Interviews",
            "description": "Tổng số phiên phỏng vấn đã tham gia"
          },
          "completed_interviews": {
            "type": "integer",
            "title": "Completed Interviews",
            "description": "Số phiên hoàn thành"
          },
          "avg_score": {
            "type": "number",
            "title": "Avg Score",
            "description": "Điểm trung bình (thang 100)"
          },
          "total_practice_minutes": {
            "type": "integer",
            "title": "Total Practice Minutes",
            "description": "Tổng thời gian luyện tập tích lũy (phút)"
          },
          "streak_days": {
            "type": "integer",
            "title": "Streak Days",
            "description": "Số ngày luyện tập liên tục (Streak)"
          }
        },
        "type": "object",
        "required": [
          "total_interviews",
          "completed_interviews",
          "avg_score",
          "total_practice_minutes",
          "streak_days"
        ],
        "title": "CandidateKpiStatsOut"
      },
      "GoogleAuthIn": {
        "properties": {
          "credential": {
            "type": "string",
            "minLength": 10,
            "title": "Credential"
          }
        },
        "type": "object",
        "required": [
          "credential"
        ],
        "title": "GoogleAuthIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryPageOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/HistorySessionItemOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "total_pages": {
            "type": "integer",
            "title": "Total Pages"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "total_pages"
        ],
        "title": "HistoryPageOut"
      },
      "HistorySessionItemOut": {
        "properties": {
          "session_id": {
            "type": "integer",
            "title": "Session Id"
          },
          "candidate_id": {
            "type": "integer",
            "title": "Candidate Id"
          },
          "domain_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain Id"
          },
          "domain_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain Name"
          },
          "role_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role Id"
          },
          "role_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role Name"
          },
          "experience_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Experience Level"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "total_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Score"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "total_turns": {
            "type": "integer",
            "title": "Total Turns"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "candidate_id",
          "domain_id",
          "domain_name",
          "role_id",
          "role_name",
          "experience_level",
          "language",
          "mode",
          "status",
          "total_score",
          "started_at",
          "completed_at",
          "total_turns"
        ],
        "title": "HistorySessionItemOut"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 255,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn"
      },
      "MessageOut": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "MessageOut"
      },
      "ProgressTrendPointOut": {
        "properties": {
          "session_id": {
            "type": "integer",
